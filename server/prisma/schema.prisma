
generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Dish {
  id       String          @id @default(uuid())
  name     String
  category String 
  price    Int
  stopEntries StopListEntry[]
}

model StopListEntry {
  id         String   @id @default(uuid())
  dishId     String
  dish       Dish     @relation(fields: [dishId], references: [id])
  reason     String
  stoppedAt  DateTime
  expiresAt  DateTime
  returnedAt DateTime? 
}